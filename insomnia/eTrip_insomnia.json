    {
      "_id": "req_002",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Login compradora de demo (sofia)",
      "method": "POST",
      "url": "{{ _.base_url }}/api/v1/auth/authenticate",
      "metaSortKey": 2,
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"usernameOrEmail\": \"sofia@plan.com\",\n  \"password\": \"plan1234\"\n}"
      },
      "afterResponseScript": "// Guarda token y user_id automaticamente apenas llega la respuesta, asi no\n// hay que copiar/pegar nada a mano en el Environment despues de cada login.\n// Si el request fallo (400/403/etc) el body no tiene access_token y no se\n// toca lo que ya estaba guardado.\nconst body = insomnia.response.json();\nif (body && body.access_token) {\n  insomnia.environment.set('token', body.access_token);\n\n  // El id del usuario no viene en el body de /register ni /authenticate, pero\n  // si viaja como claim 'id' adentro del JWT (ver JwtService.buildToken), asi\n  // que lo sacamos de ahi sin tener que pegarle a /users/me aparte.\n  try {\n    const payloadB64 = body.access_token.split('.')[1];\n    const normalized = payloadB64.replace(/-/g, '+').replace(/_/g, '/');\n    const payload = JSON.parse(decodeURIComponent(atob(normalized).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));\n    if (payload && payload.id !== undefined) {\n      insomnia.environment.set('user_id', payload.id);\n    }\n  } catch (e) {\n    // si cambia el formato del token en algun momento, no rompemos el resto\n  }\n}\n"
    },
